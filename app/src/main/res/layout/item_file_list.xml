<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFileList"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginVertical="3.5dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/vaultx_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/vaultx_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/vaultx_surface_variant"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivIconList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_doc"
                android:contentDescription="@null" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvFileNameList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textColor="@color/vaultx_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFileMetaList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:textColor="@color/vaultx_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFavoriteList"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="@string/action_favorite" />

        <ImageView
            android:id="@+id/btnMoreOptionsList"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/vaultx_text_secondary"
            android:contentDescription="File options" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
