<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/vaultx_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/vaultx_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thumbnail Image Container with 120dp preview -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:background="@color/vaultx_surface_variant">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Video Play Badge Overlay -->
            <ImageView
                android:id="@+id/ivPlayBadge"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:padding="8dp"
                android:src="@drawable/ic_play"
                app:tint="@color/white"
                android:background="@drawable/bg_circle_translucent"
                android:visibility="gone"
                android:contentDescription="@null" />

            <!-- Favorite Star Button Overlay -->
            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:padding="5dp"
                android:src="@drawable/ic_star_outline"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="@string/action_favorite" />
        </FrameLayout>

        <!-- Metadata Section below thumbnail -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textColor="@color/vaultx_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/vaultx_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3-Dots More Options Button -->
            <ImageView
                android:id="@+id/btnMoreOptions"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/vaultx_text_secondary"
                android:contentDescription="File options" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
